<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_update_schedule" model="ir.ui.view">
        <field name="name">purchase.order.form.update.schedule</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_update_schedule" type="object"
                        string="Обновить график"
                        class="btn-primary"
                        invisible="state not in ('purchase', 'done')"/>
                <button name="action_create_return" type="object"
                        string="Оформить возврат"
                        invisible="state not in ('purchase', 'done')"/>
            </xpath>

        </field>
    </record>

</odoo>
