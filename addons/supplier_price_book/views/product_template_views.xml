<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_supplier_price" model="ir.ui.view">
        <field name="name">product.template.form.supplier.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Показываем наши вычисляемые поля с подписями над таблицей поставщиков -->
            <xpath expr="//field[@name='seller_ids']" position="before">
                <group string="Лучшая цена закупки">
                    <field name="cheapest_supplier_id"/>
                    <field name="cheapest_supplier_price"/>
                </group>
            </xpath>

            <!--
            Упрощение таблицы поставщиков

            <xpath expr="//field[@name='seller_ids']/list/field[@name='delay']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='seller_ids']/list/field[@name='min_qty']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            -->

        </field>
    </record>

</odoo>
